#include <iostream>
#include <vector>
using namespace std;

const int INF = 9999;

int n;
vector<vector<int>> cost, dist, nextHop;

void display() {
    for (int i = 0; i < n; i++) {
        cout << "\nRouting Table for Router " << i + 1 << ":\n";
        cout << "Destination\tCost\tNext Hop\n";

        for (int j = 0; j < n; j++) {
            cout << j + 1 << "\t\t";

            if (dist[i][j] == INF)
                cout << "INF";
            else
                cout << dist[i][j];

            cout << "\t";

            if (nextHop[i][j] == -1)
                cout << "-";
            else
                cout << nextHop[i][j] + 1;

            cout << "\n";
        }
    }
}

int main() {
    cout << "Enter number of routers: ";
    cin >> n;

    cost.resize(n, vector<int>(n));
    dist.resize(n, vector<int>(n));
    nextHop.resize(n, vector<int>(n));

    cout << "Enter the cost matrix (9999 for infinity):\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];
            dist[i][j] = cost[i][j];

            if (i == j)
                nextHop[i][j] = i;
            else if (cost[i][j] != INF)
                nextHop[i][j] = j;
            else
                nextHop[i][j] = -1;
        }
    }

    cout << "\nInitial Routing Tables:\n";
    display();

    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (dist[i][k] != INF &&
                    dist[k][j] != INF &&
                    dist[i][k] + dist[k][j] < dist[i][j]) {

                    dist[i][j] = dist[i][k] + dist[k][j];
                    nextHop[i][j] = nextHop[i][k];
                }
            }
        }

        cout << "\nAfter Step " << k + 1 << ":\n";
        display();
    }

    return 0;
}
